<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutFactura"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".crearfactura"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Buscar Cliente -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar cliente"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscarCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Lista de clientes -->
            <TextView
                android:id="@+id/tvSinResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin resultados"
                android:visibility="gone"
                android:textColor="@android:color/holo_red_dark"
                android:paddingTop="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvClientes"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:visibility="gone" />

            <!-- Cliente seleccionado -->
            <TextView
                android:id="@+id/tvClienteInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente seleccionado"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:visibility="gone" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="12dp" />

            <!-- Buscar producto -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar producto"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscarProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSeleccionados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos seleccionados"
                android:padding="8dp"
                android:textStyle="bold"
                android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductosSeleccionados"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

        </LinearLayout>
    </ScrollView>


    <LinearLayout
        android:id="@+id/Lytotales"
        android:layout_margin="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:gravity="center">

        <TextView
            android:id="@+id/tvsubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sub Total: $0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end"
            android:padding="0dp" />
        <TextView
            android:id="@+id/tvpropina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Propina: $0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end"
            android:padding="0dp" />
        <!-- Total -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: $0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end"
            android:padding="0dp" />

        <TextView
            android:id="@+id/tvmetododepago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar método de pago"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />
        <LinearLayout
            android:orientation="vertical"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioOption1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efectivo" />

                <RadioButton
                    android:id="@+id/radioOption2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarjeta de crédito" />

                <RadioButton
                    android:id="@+id/radioOption3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cxc" />
            </RadioGroup>

        </LinearLayout>



        <LinearLayout
            android:layout_margin="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:gravity="center_horizontal">

    <Button
        android:id="@+id/btnConfirmarFactura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirmar Factura"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:backgroundTint="@color/colorDorado"
        android:textColor="@android:color/white"
        android:maxHeight="48dp"
        android:minHeight="48dp"/>
        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="            Salir            "
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:backgroundTint="@color/colorDorado"
            android:textColor="@android:color/white"
            android:maxHeight="48dp"
            android:minHeight="48dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
