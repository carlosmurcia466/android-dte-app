<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="2dp"
        android:outlineAmbientShadowColor="@color/colorDorado"
        android:orientation="vertical">

        <!-- Fila: Nombre, Precio, Botón Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="0dp"
            android:gravity="center_vertical">

            <!-- Columna izquierda: nombre y precio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDescripcionProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Producto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPrecioProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio: $0.00" />
            </LinearLayout>

            <!-- Botón eliminar -->
            <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/borrar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar producto" />
        </LinearLayout>

        <!-- Fila: botones + y - y cantidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="0dp">

            <ImageButton
                android:id="@+id/btnDisminuir"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/menos"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Disminuir cantidad" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="1"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnAumentar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/mas"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Aumentar cantidad" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/colorDorado"
            android:layout_marginVertical="0dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
